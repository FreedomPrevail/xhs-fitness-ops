# Copy only the variables you need into your shell environment.
# Never place real secrets in a tracked file.

XHS_OPERATION_MODE=manual_connected

# http or codex_cli
XHS_LLM_PROVIDER=http
XHS_LLM_BASE_URL=https://provider.example/v1
XHS_LLM_API_KEY=
XHS_LLM_MODEL=

# Optional role overrides: http or codex_cli
XHS_TOPIC_PROVIDER=
XHS_GOLDEN_PROVIDER=
XHS_CONTENT_PROVIDER=
XHS_OUTLINE_PROVIDER=
XHS_COVER_PROVIDER=
XHS_IMAGE_PROVIDER=

# Optional Codex settings
CODEX_CLI_PATH=
XHS_CODEX_MODEL=
XHS_CODEX_REASONING=
XHS_CODEX_TOPIC_REASONING=high
XHS_CODEX_GOLDEN_REASONING=high
XHS_CODEX_CONTENT_REASONING=high
XHS_CODEX_OUTLINE_REASONING=medium
XHS_CODEX_COVER_REASONING=medium
XHS_CODEX_IMAGE_REASONING=low

# Connected browser session
XHS_UI_SESSION=xhs-ui
XHS_DATA_CENTER_MAX_PAGES=12

# Optional local Chromium executable used by HTML rendering
XHS_BROWSER_EXECUTABLE=

# Optional Canva Connect API. Prefer the configure command and OS keychain.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=http://127.0.0.1:8765/oauth/callback
CANVA_SCOPES=design:content:write

